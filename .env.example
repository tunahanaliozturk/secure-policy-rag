# Copy to .env for `uv run spr ...` against the compose database. Every value here is a local placeholder.
SPR_ADMIN_DATABASE_URL=postgresql://postgres:local-dev-admin@127.0.0.1:55440/policies
SPR_APP_DB_PASSWORD=local-dev-app
SPR_DATABASE_URL=postgresql://spr_app:local-dev-app@127.0.0.1:55440/policies
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
SPR_TOKEN_SECRET=
SPR_MODEL_PROVIDER=scripted
SPR_MODEL_CACHE_DIR=.models
