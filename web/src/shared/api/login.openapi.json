{
  "components": {
    "schemas": {
      "ClearanceLabel": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ],
        "type": "string"
      },
      "Department": {
        "enum": [
          "credit",
          "compliance",
          "data",
          "security",
          "hr",
          "markets"
        ],
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Issued": {
        "properties": {
          "clearance": {
            "$ref": "#/components/schemas/ClearanceLabel"
          },
          "departments": {
            "items": {
              "$ref": "#/components/schemas/Department"
            },
            "title": "Departments",
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "departments",
          "clearance",
          "token",
          "expires_at"
        ],
        "title": "Issued",
        "type": "object"
      },
      "People": {
        "properties": {
          "identities": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "title": "Identities",
            "type": "array"
          }
        },
        "required": [
          "identities"
        ],
        "title": "People",
        "type": "object"
      },
      "Person": {
        "properties": {
          "clearance": {
            "$ref": "#/components/schemas/ClearanceLabel"
          },
          "departments": {
            "items": {
              "$ref": "#/components/schemas/Department"
            },
            "title": "Departments",
            "type": "array"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "departments",
          "clearance"
        ],
        "title": "Person",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Who": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9._-]+$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "Who",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "secure-policy-rag demo login",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/identities": {
      "get": {
        "operationId": "identities_identities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/People"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Identities"
      }
    },
    "/token": {
      "post": {
        "operationId": "token_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Who"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issued"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not one of the demo identities."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Token"
      }
    }
  }
}
